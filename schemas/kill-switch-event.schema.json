{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:edgelab:kill-switch-event:1", "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "generation", "event_type", "phase", "occurred_at", "trigger", "evidence_sha256", "remediation_refs", "reset_attestation_ids", "previous_event_sha256", "event_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "event_id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "generation": {"type": "integer", "minimum": 1}, "event_type": {"enum": ["INITIAL_ENGAGE", "TRIGGER", "RESET"]}, "phase": {"type": "string", "minLength": 1}, "occurred_at": {"type": "string", "format": "date-time"}, "trigger": {"type": ["string", "null"], "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha"}, "remediation_refs": {"type": "array", "items": {"$ref": "#/$defs/sha"}}, "reset_attestation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "previous_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "event_sha256": {"$ref": "#/$defs/sha"}
  }
}
