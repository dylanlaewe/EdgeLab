{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:edgelab:stop-resolution-event:1", "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "stop_id", "stop_version", "stop_sha256", "occurred_at", "acknowledged", "remediation_evidence", "descendants_revalidated", "required_roles", "capital_implicated", "remediation_author_actor_ids", "event_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "event_id": {"type": "string", "minLength": 1}, "stop_id": {"type": "string", "minLength": 1}, "stop_version": {"type": "integer", "minimum": 1}, "stop_sha256": {"$ref": "#/$defs/sha"}, "occurred_at": {"type": "string", "format": "date-time"}, "acknowledged": {"type": "boolean"},
    "remediation_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}}, "descendants_revalidated": {"type": "boolean"}, "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "capital_implicated": {"type": "boolean"}, "remediation_author_actor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "event_sha256": {"$ref": "#/$defs/sha"}
  }
}
