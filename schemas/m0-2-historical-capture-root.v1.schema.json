{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root_id",
    "base_trusted_root_id",
    "base_trusted_root_sha256",
    "captures",
    "root_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "root_id": {"const": "M0-2-HISTORICAL-CAPTURE-ROOT-V1"},
    "base_trusted_root_id": {"const": "M0-2-STAGE1-TRUST-ROOT-V1"},
    "base_trusted_root_sha256": {"$ref": "#/$defs/sha256"},
    "captures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capture_id",
          "fixture_path",
          "sidecar_sha256",
          "graph_sha256",
          "repository_inventory_sha256",
          "packages"
        ],
        "properties": {
          "capture_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "fixture_path": {"type": "string", "pattern": "^tests/fixtures/"},
          "sidecar_sha256": {"$ref": "#/$defs/sha256"},
          "graph_sha256": {"$ref": "#/$defs/sha256"},
          "repository_inventory_sha256": {"$ref": "#/$defs/sha256"},
          "packages": {
            "$ref": "m0-2-authentic-capture.v1.schema.json#/properties/packages"
          }
        }
      }
    },
    "root_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
