{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:quant-protocol:1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "id", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["application/json", "text/plain", "text/x-python"]}
      }
    },
    "ref_list": {"type": "array", "items": {"$ref": "#/$defs/typed_ref"}, "uniqueItems": true}
  },
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "created_at", "supersedes", "kind",
    "preregistration_ref", "frozen_at", "pre_access_checkpoint_sha256",
    "splits", "required_splits", "code", "configuration", "environment",
    "randomness", "deterministic_settings", "execution_assumptions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supersedes": {"anyOf": [{"$ref": "#/$defs/typed_ref"}, {"type": "null"}]},
    "kind": {"const": "quant-protocol"},
    "preregistration_ref": {"$ref": "#/$defs/typed_ref"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "pre_access_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "splits": {
      "type": "object", "additionalProperties": false,
      "required": ["train", "validation", "test", "holdout"],
      "properties": {
        "train": {"$ref": "#/$defs/ref_list"},
        "validation": {"$ref": "#/$defs/ref_list"},
        "test": {"$ref": "#/$defs/ref_list"},
        "holdout": {"$ref": "#/$defs/ref_list"}
      }
    },
    "required_splits": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["train", "validation", "test", "holdout"]},
      "contains": {"const": "holdout"}
    },
    "code": {"$ref": "#/$defs/blob"},
    "configuration": {"$ref": "#/$defs/blob"},
    "environment": {"$ref": "#/$defs/blob"},
    "randomness": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "seed", "algorithm", "explanation"],
      "properties": {
        "mode": {"enum": ["SEEDED", "DETERMINISTIC_NO_RANDOMNESS"]},
        "seed": {"type": ["integer", "null"]},
        "algorithm": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "deterministic_settings": {"$ref": "#/$defs/blob"},
    "execution_assumptions": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
