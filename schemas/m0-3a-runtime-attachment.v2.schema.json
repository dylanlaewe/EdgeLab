{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:m0-3a-runtime-attachment:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attachment_schema_version", "runtime_format_version", "runtime_id",
    "chain_id", "canonical_project_id", "repository_root_realpath",
    "expected_remote", "git_common_dir_identity", "repository_marker_sha256",
    "checkout_nonce", "created_at", "anchor_status", "currentness_status",
    "authorizing_use"
  ],
  "properties": {
    "attachment_schema_version": {"const": 2},
    "runtime_format_version": {"const": 2},
    "runtime_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "chain_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_project_id": {"const": "EdgeLab"},
    "repository_root_realpath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "expected_remote": {"const": "https://github.com/dylanlaewe/EdgeLab.git"},
    "git_common_dir_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_marker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkout_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "anchor_status": {"const": "UNANCHORED"},
    "currentness_status": {"const": "UNKNOWN"},
    "authorizing_use": {"const": "DENY"}
  }
}
