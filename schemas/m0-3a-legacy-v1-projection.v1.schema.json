{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:m0-3a-legacy-v1-projection:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_format_version", "source_runtime_format_version",
    "source_assurance", "source_runtime_id", "attachment_sha256",
    "storage_inventory_sha256", "backup_sha256", "global_head_id",
    "global_head_sha256", "repository_generation", "repository_bundle_sha256",
    "meta_keys", "tables", "legacy_event_type_mapping", "row_archive_sha256",
    "projection_sha256", "currentness_status", "authorizing_use", "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "projection_format_version": {"const": 1},
    "source_runtime_format_version": {"const": 1},
    "source_assurance": {"const": "V16_BOUNDED_REPLAY_ONLY"},
    "source_runtime_id": {"type": "string", "minLength": 1},
    "attachment_sha256": {"$ref": "#/$defs/digest"},
    "storage_inventory_sha256": {"$ref": "#/$defs/digest"},
    "backup_sha256": {"$ref": "#/$defs/digest"},
    "global_head_id": {"type": "string", "minLength": 1},
    "global_head_sha256": {"$ref": "#/$defs/digest"},
    "repository_generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "repository_bundle_sha256": {"$ref": "#/$defs/digest"},
    "meta_keys": {
      "const": [
        "attachment_digest", "available", "bundle_digest", "genesis",
        "genesis_digest", "global_head_digest", "global_head_id",
        "repository_generation", "runtime_id", "schema_version"
      ]
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta", "seals", "tasks", "attempts", "claims", "reviews",
        "idempotency", "runtime_events", "task_events", "remediation_links",
        "migration_ledger", "snapshots"
      ],
      "properties": {
        "meta": {"$ref": "#/$defs/metaTable"},
        "seals": {"$ref": "#/$defs/sealsTable"},
        "tasks": {"$ref": "#/$defs/tasksTable"},
        "attempts": {"$ref": "#/$defs/attemptsTable"},
        "claims": {"$ref": "#/$defs/claimsTable"},
        "reviews": {"$ref": "#/$defs/reviewsTable"},
        "idempotency": {"$ref": "#/$defs/idempotencyTable"},
        "runtime_events": {"$ref": "#/$defs/runtimeEventsTable"},
        "task_events": {"$ref": "#/$defs/taskEventsTable"},
        "remediation_links": {"$ref": "#/$defs/remediationLinksTable"},
        "migration_ledger": {"$ref": "#/$defs/migrationLedgerTable"},
        "snapshots": {"$ref": "#/$defs/snapshotsTable"}
      }
    },
    "legacy_event_type_mapping": {
      "const": {
        "TASK_YIELDD": "TASK_YIELDED",
        "TASK_FAILD": "TASK_FAILED",
        "REVIEW_REJECTD": "REVIEW_REJECTED"
      }
    },
    "row_archive_sha256": {"$ref": "#/$defs/digest"},
    "projection_sha256": {"$ref": "#/$defs/digest"},
    "currentness_status": {"const": "UNKNOWN"},
    "authorizing_use": {"const": "DENY"},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns_sha256", "row_schema_id", "row_count", "ordered_rows_sha256"],
      "properties": {
        "columns_sha256": {"$ref": "#/$defs/digest"},
        "row_schema_id": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "ordered_rows_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "metaTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/metaRow"}}}]},
    "sealsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/sealsRow"}}}]},
    "tasksTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/tasksRow"}}}]},
    "attemptsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/attemptsRow"}}}]},
    "claimsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/claimsRow"}}}]},
    "reviewsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/reviewsRow"}}}]},
    "idempotencyTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/idempotencyRow"}}}]},
    "runtimeEventsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/runtimeEventsRow"}}}]},
    "taskEventsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/taskEventsRow"}}}]},
    "remediationLinksTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/remediationLinksRow"}}}]},
    "migrationLedgerTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/migrationLedgerRow"}}}]},
    "snapshotsTable": {"allOf": [{"$ref": "#/$defs/table"}, {"properties": {"row_schema_id": {"const": "urn:edgelab:m0-3a-legacy-v1-row-archive:1#/$defs/snapshotsRow"}}}]}
  }
}
