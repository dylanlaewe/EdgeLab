{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:m0-3a-command-request:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_format_version", "runtime_id", "chain_id",
    "operation", "operation_key", "repository_generation",
    "repository_bundle_sha256", "subject", "expected_state_ref", "arguments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_format_version": {"const": 2},
    "runtime_id": {"$ref": "#/$defs/generatedId"},
    "chain_id": {"$ref": "#/$defs/digest"},
    "operation": {
      "enum": [
        "SYSTEM_GENESIS", "SYSTEM_LEGACY_BRIDGE", "INITIALIZE", "CLAIM",
        "START", "CONTINUE", "YIELD", "FAIL", "COMPLETE", "RECOVER",
        "RETRY", "GOVERNANCE_BLOCK", "REVALIDATE", "ASSIGN_REVIEW",
        "APPROVE", "REJECT", "REMEDIATE", "ROUTE",
        "CREATE_REMEDIATION_TASK", "IMPORT_REPOSITORY", "CHECKPOINT",
        "EXPORT_SNAPSHOT"
      ]
    },
    "operation_key": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?:system:v2:(?:genesis|legacy-bridge)|v2:[0-9a-f]{64}:[\\x21-\\x7e]{1,180})$"},
    "repository_generation": {"$ref": "#/$defs/nonnegativeInteger"},
    "repository_bundle_sha256": {"$ref": "#/$defs/digest"},
    "subject": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/taskSubject"}, {"$ref": "#/$defs/remediationSubject"}]},
    "expected_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stateRef"}]},
    "arguments": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"enum": ["SYSTEM_GENESIS", "SYSTEM_LEGACY_BRIDGE", "IMPORT_REPOSITORY", "CHECKPOINT", "EXPORT_SNAPSHOT"]}}, "required": ["operation"]}, "then": {"properties": {"subject": {"type": "null"}, "expected_state_ref": {"type": "null"}}}},
    {"if": {"properties": {"operation": {"const": "SYSTEM_GENESIS"}}, "required": ["operation"]}, "then": {"properties": {"operation_key": {"const": "system:v2:genesis"}, "arguments": {"$ref": "#/$defs/genesisArguments"}}}},
    {"if": {"properties": {"operation": {"const": "SYSTEM_LEGACY_BRIDGE"}}, "required": ["operation"]}, "then": {"properties": {"operation_key": {"const": "system:v2:legacy-bridge"}, "arguments": {"$ref": "#/$defs/bridgeArguments"}}}},
    {"if": {"properties": {"operation": {"enum": ["INITIALIZE", "CLAIM", "START", "CONTINUE", "YIELD", "FAIL", "COMPLETE", "RECOVER", "RETRY", "GOVERNANCE_BLOCK", "REVALIDATE", "ASSIGN_REVIEW", "APPROVE", "REJECT", "REMEDIATE", "ROUTE", "CREATE_REMEDIATION_TASK", "IMPORT_REPOSITORY", "CHECKPOINT", "EXPORT_SNAPSHOT"]}}, "required": ["operation"]}, "then": {"properties": {"operation_key": {"pattern": "^v2:[0-9a-f]{64}:[\\x21-\\x7e]{1,180}$"}}}},
    {"if": {"properties": {"operation": {"const": "INITIALIZE"}}, "required": ["operation"]}, "then": {"properties": {"subject": {"$ref": "#/$defs/taskSubject"}, "expected_state_ref": {"type": "null"}, "arguments": {"$ref": "#/$defs/initializeArguments"}}}},
    {"if": {"properties": {"operation": {"enum": ["CLAIM", "START", "CONTINUE", "YIELD", "FAIL", "COMPLETE", "RECOVER", "GOVERNANCE_BLOCK", "REVALIDATE", "ASSIGN_REVIEW", "APPROVE", "REJECT", "REMEDIATE", "ROUTE"]}}, "required": ["operation"]}, "then": {"properties": {"subject": {"$ref": "#/$defs/taskSubject"}, "expected_state_ref": {"$ref": "#/$defs/stateRef"}}}},
    {"if": {"properties": {"operation": {"const": "RETRY"}}, "required": ["operation"]}, "then": {"properties": {"subject": {"$ref": "#/$defs/taskSubject"}, "expected_state_ref": {"$ref": "#/$defs/stateRef"}, "arguments": {"$ref": "#/$defs/retryArguments"}}}},
    {"if": {"properties": {"operation": {"const": "CLAIM"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/claimArguments"}}}},
    {"if": {"properties": {"operation": {"const": "START"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/workerArguments"}}}},
    {"if": {"properties": {"operation": {"const": "CONTINUE"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/continueArguments"}}}},
    {"if": {"properties": {"operation": {"const": "YIELD"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/yieldArguments"}}}},
    {"if": {"properties": {"operation": {"const": "FAIL"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/failArguments"}}}},
    {"if": {"properties": {"operation": {"const": "COMPLETE"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/completeArguments"}}}},
    {"if": {"properties": {"operation": {"const": "RECOVER"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/recoverArguments"}}}},
    {"if": {"properties": {"operation": {"const": "GOVERNANCE_BLOCK"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/governanceArguments"}}}},
    {"if": {"properties": {"operation": {"const": "REVALIDATE"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/revalidateArguments"}}}},
    {"if": {"properties": {"operation": {"const": "ASSIGN_REVIEW"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/reviewAssignmentArguments"}}}},
    {"if": {"properties": {"operation": {"enum": ["APPROVE", "REJECT", "REMEDIATE"]}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/reviewDecisionArguments"}}}},
    {"if": {"properties": {"operation": {"const": "ROUTE"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/routeArguments"}}}},
    {"if": {"properties": {"operation": {"const": "CREATE_REMEDIATION_TASK"}}, "required": ["operation"]}, "then": {"properties": {"subject": {"$ref": "#/$defs/remediationSubject"}, "expected_state_ref": {"$ref": "#/$defs/stateRef"}, "arguments": {"$ref": "#/$defs/remediationArguments"}}}},
    {"if": {"properties": {"operation": {"const": "IMPORT_REPOSITORY"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/importArguments"}}}},
    {"if": {"properties": {"operation": {"const": "CHECKPOINT"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/checkpointArguments"}}}},
    {"if": {"properties": {"operation": {"const": "EXPORT_SNAPSHOT"}}, "required": ["operation"]}, "then": {"properties": {"arguments": {"$ref": "#/$defs/exportArguments"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generatedId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\x20-\\x7e]+$"},
    "nonnegativeInteger": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "taskSubject": {"type": "object", "additionalProperties": false, "required": ["task_id", "attempt"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "attempt": {"$ref": "#/$defs/positiveInteger"}}},
    "remediationSubject": {"type": "object", "additionalProperties": false, "required": ["source_task_id", "source_attempt", "child_task_id", "child_attempt"], "properties": {"source_task_id": {"$ref": "#/$defs/taskId"}, "source_attempt": {"$ref": "#/$defs/positiveInteger"}, "child_task_id": {"$ref": "#/$defs/taskId"}, "child_attempt": {"const": 1}}},
    "blobRef": {"type": "object", "additionalProperties": false, "required": ["schema_id", "sha256"], "properties": {"schema_id": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"$ref": "#/$defs/digest"}}},
    "stateRef": {"type": "object", "additionalProperties": false, "required": ["schema_id", "sha256"], "properties": {"schema_id": {"const": "urn:edgelab:m0-3a-task-state:2"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "genesisArguments": {"type": "object", "additionalProperties": false, "required": ["attachment_sha256", "schema_registry_sha256", "storage_schema_sha256"], "properties": {"attachment_sha256": {"$ref": "#/$defs/digest"}, "schema_registry_sha256": {"$ref": "#/$defs/digest"}, "storage_schema_sha256": {"$ref": "#/$defs/digest"}}},
    "bridgeArguments": {"type": "object", "additionalProperties": false, "required": ["attachment_sha256", "schema_registry_sha256", "storage_schema_sha256", "legacy_archive_ref", "legacy_projection_ref"], "properties": {"attachment_sha256": {"$ref": "#/$defs/digest"}, "schema_registry_sha256": {"$ref": "#/$defs/digest"}, "storage_schema_sha256": {"$ref": "#/$defs/digest"}, "legacy_archive_ref": {"$ref": "#/$defs/blobRef"}, "legacy_projection_ref": {"$ref": "#/$defs/blobRef"}}},
    "initializeArguments": {"type": "object", "additionalProperties": false, "required": ["decision_receipt_digest", "owner", "owner_role"], "properties": {"decision_receipt_digest": {"$ref": "#/$defs/digest"}, "owner": {"$ref": "#/$defs/identity"}, "owner_role": {"$ref": "#/$defs/identity"}}},
    "claimArguments": {"type": "object", "additionalProperties": false, "required": ["actor"], "properties": {"actor": {"$ref": "#/$defs/identity"}}},
    "workerArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "fence"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "fence": {"$ref": "#/$defs/nonnegativeInteger"}}},
    "continueArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "fence", "progress_evidence_sha256"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "fence": {"$ref": "#/$defs/nonnegativeInteger"}, "progress_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "yieldArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "fence", "yield_evidence_sha256"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "fence": {"$ref": "#/$defs/nonnegativeInteger"}, "yield_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "failArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "fence", "failure_code", "failure_evidence_sha256"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "fence": {"$ref": "#/$defs/nonnegativeInteger"}, "failure_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "failure_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "completeArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "fence", "close", "completion_evidence_sha256"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "fence": {"$ref": "#/$defs/nonnegativeInteger"}, "close": {"type": "boolean"}, "completion_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "recoverArguments": {"type": "object", "additionalProperties": false, "required": ["claim_id", "liveness_evidence_sha256"], "properties": {"claim_id": {"$ref": "#/$defs/generatedId"}, "liveness_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "retryArguments": {"type": "object", "additionalProperties": false, "required": ["retryable", "retry_evidence_sha256"], "properties": {"retryable": {"const": true}, "retry_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "governanceArguments": {"type": "object", "additionalProperties": false, "required": ["reason_code", "evidence_sha256"], "properties": {"reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "revalidateArguments": {"type": "object", "additionalProperties": false, "required": ["evidence_sha256"], "properties": {"evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "reviewAssignmentArguments": {"type": "object", "additionalProperties": false, "required": ["actor", "role"], "properties": {"actor": {"$ref": "#/$defs/identity"}, "role": {"$ref": "#/$defs/identity"}}},
    "reviewDecisionArguments": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "decision_sha256"], "properties": {"assignment_id": {"$ref": "#/$defs/generatedId"}, "decision_sha256": {"$ref": "#/$defs/digest"}}},
    "routeArguments": {"type": "object", "additionalProperties": false, "required": ["routing_evidence_sha256"], "properties": {"routing_evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "remediationArguments": {"type": "object", "additionalProperties": false, "required": ["relationship_id", "decision_sha256", "child_decision_receipt_digest", "child_owner", "child_owner_role"], "properties": {"relationship_id": {"$ref": "#/$defs/generatedId"}, "decision_sha256": {"$ref": "#/$defs/digest"}, "child_decision_receipt_digest": {"$ref": "#/$defs/digest"}, "child_owner": {"$ref": "#/$defs/identity"}, "child_owner_role": {"$ref": "#/$defs/identity"}}},
    "importArguments": {"type": "object", "additionalProperties": false, "required": ["affected_task_ids", "reason_code", "source_commit", "project_state_sha256", "stop_set_sha256", "policy_capability_sha256", "task_inventory_sha256"], "properties": {"affected_task_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "project_state_sha256": {"$ref": "#/$defs/digest"}, "stop_set_sha256": {"$ref": "#/$defs/digest"}, "policy_capability_sha256": {"$ref": "#/$defs/digest"}, "task_inventory_sha256": {"$ref": "#/$defs/digest"}}},
    "checkpointArguments": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "checkpoint_sequence", "checkpoint_sha256", "checkpoint_blob_sha256", "prior_checkpoint_sha256", "next_selector_generation", "next_selector_sha256", "next_selector_history_sha256"], "properties": {"snapshot_id": {"$ref": "#/$defs/generatedId"}, "checkpoint_sequence": {"$ref": "#/$defs/nonnegativeInteger"}, "checkpoint_sha256": {"$ref": "#/$defs/digest"}, "checkpoint_blob_sha256": {"$ref": "#/$defs/digest"}, "prior_checkpoint_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "next_selector_generation": {"$ref": "#/$defs/positiveInteger"}, "next_selector_sha256": {"$ref": "#/$defs/digest"}, "next_selector_history_sha256": {"$ref": "#/$defs/digest"}}},
    "exportArguments": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "export_sequence", "export_sha256", "export_blob_sha256", "prior_export_sha256"], "properties": {"snapshot_id": {"$ref": "#/$defs/generatedId"}, "export_sequence": {"$ref": "#/$defs/nonnegativeInteger"}, "export_sha256": {"$ref": "#/$defs/digest"}, "export_blob_sha256": {"$ref": "#/$defs/digest"}, "prior_export_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}}}
  }
}
