{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:m0-3a-runtime-v2-schema-declarative-keyword-proof:1",
  "title": "EdgeLab runtime-v2 schema declarative keyword proof V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_kind",
    "constraint_id",
    "classification",
    "semantic_subject",
    "schema_site_id",
    "addressed_site",
    "schema_context",
    "declarative_equation",
    "unit",
    "evidence_inputs"
  ],
  "properties": {
    "proof_kind": {
      "const": "SCHEMA_DECLARATIVE_KEYWORD_V1"
    },
    "constraint_id": {
      "type": "string",
      "pattern": "^SCHEMA_DECLARATIVE_[A-Z][A-Z0-9_]*$"
    },
    "classification": {
      "const": "SCHEMA_DECLARATIVE_BOUND"
    },
    "semantic_subject": {
      "type": "string",
      "pattern": "^SCHEMA_DECLARATIVE_[A-Z][A-Z0-9_]*$"
    },
    "schema_site_id": {
      "$ref": "#/$defs/sha256"
    },
    "addressed_site": {
      "$ref": "#/$defs/addressedSite"
    },
    "schema_context": {
      "$ref": "#/$defs/schemaContext"
    },
    "declarative_equation": {
      "$ref": "#/$defs/declarativeEquation"
    },
    "unit": {
      "enum": [
        "ARRAY_ITEMS",
        "CONTAINS_MATCHES",
        "JSON_NUMBER",
        "OBJECT_PROPERTIES",
        "UNICODE_CODE_POINTS"
      ]
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceInput"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~]|~[01])*)*$"
    },
    "addressedSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "json_pointer",
        "keyword",
        "path",
        "schema_id",
        "site_id",
        "value"
      ],
      "properties": {
        "classification": {
          "const": "UNCLASSIFIED"
        },
        "json_pointer": {
          "allOf": [
            {"$ref": "#/$defs/jsonPointer"},
            {"pattern": "^/"}
          ]
        },
        "keyword": {
          "enum": [
            "exclusiveMaximum",
            "exclusiveMinimum",
            "maxContains",
            "maxItems",
            "maxLength",
            "maxProperties",
            "maximum",
            "minContains",
            "minItems",
            "minLength",
            "minProperties",
            "minimum"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "$ref": "#/$defs/sha256"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "schemaContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialect",
        "schema_document_byte_length",
        "schema_document_raw_sha256",
        "schema_document_root_id",
        "containing_subschema_pointer",
        "containing_subschema_digest",
        "applicability",
        "instance_domain",
        "ancestor_context",
        "required_sibling_pointers",
        "non_domain_behavior"
      ],
      "properties": {
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "schema_document_byte_length": {
          "type": "integer",
          "minimum": 2
        },
        "schema_document_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_document_root_id": {
          "type": "string",
          "minLength": 1
        },
        "containing_subschema_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "containing_subschema_digest": {
          "$ref": "#/$defs/sha256"
        },
        "applicability": {
          "const": "EXACT_PINNED_SCHEMA_LOCATION_ONLY"
        },
        "instance_domain": {
          "enum": ["ARRAY", "NUMBER", "OBJECT", "STRING"]
        },
        "ancestor_context": {
          "$ref": "#/$defs/ancestorContext"
        },
        "required_sibling_pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jsonPointer"
          }
        },
        "non_domain_behavior": {
          "const": "NO_ASSERTION_FROM_THIS_KEYWORD"
        }
      }
    },
    "declarativeEquation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "bound"],
      "properties": {
        "metric": {
          "enum": [
            "ARRAY_ITEM_COUNT",
            "CONTAINS_MATCH_COUNT",
            "JSON_NUMBER_VALUE",
            "OBJECT_PROPERTY_COUNT",
            "UNICODE_CODE_POINT_COUNT"
          ]
        },
        "operator": {
          "enum": ["<", "<=", ">", ">="]
        },
        "bound": {
          "type": "integer"
        }
      }
    },
    "ancestorContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "ordered_pointer_sequence"],
      "properties": {
        "binding": {
          "const": "FULL_SCHEMA_DOCUMENT_RAW_SHA256"
        },
        "ordered_pointer_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "pointer"],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "pointer": {
                "$ref": "#/$defs/jsonPointer"
              }
            }
          }
        }
      }
    },
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "path", "raw_sha256"],
      "properties": {
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
