    {"properties": {"event_type": {"const": "REVIEW_ASSIGNED"}, "data": {"$ref": "#/$defs/review"}}},
    {"properties": {"event_type": {"enum": ["REMEDIATION_CREATED", "TASK_CREATED_FROM_REMEDIATION"]}, "data": {"$ref": "#/$defs/relationship"}}},
