    {"properties": {"event_type": {"const": "RUNTIME_GENESIS"}, "data": {"$ref": "#/$defs/genesis"}}},
    {"properties": {"event_type": {"const": "LEGACY_V1_BRIDGE"}, "data": {"$ref": "#/$defs/bridge"}}},
