{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:m0-3a-event-envelope:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_format_version", "runtime_id", "chain_id",
    "event_id", "event_type", "occurred_at", "global_sequence",
    "global_predecessor", "stream", "task_context", "transaction",
    "payload_ref", "state_before_ref", "state_after_ref",
    "repository_generation", "repository_bundle_sha256",
    "authority_binding_sha256", "authorizing_use", "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_format_version": {"const": 2},
    "runtime_id": {"$ref": "#/$defs/generatedId"},
    "chain_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_id": {"$ref": "#/$defs/generatedId"},
    "event_type": {
      "enum": [
        "RUNTIME_GENESIS", "LEGACY_V1_BRIDGE", "COMMAND_COMMITTED",
        "TASK_INITIALIZED", "CLAIM_ISSUED", "TASK_STARTED",
        "TASK_CONTINUED", "TASK_YIELDED", "TASK_FAILED", "TASK_COMPLETED",
        "CLAIM_RECOVERED", "TASK_RETRIED", "GOVERNANCE_BLOCKED",
        "GOVERNANCE_REVALIDATED", "REVIEW_ASSIGNED", "REVIEW_APPROVED",
        "REVIEW_REJECTED", "REVIEW_REMEDIATED", "DIRECTOR_ROUTED",
        "REMEDIATION_CREATED", "TASK_CREATED_FROM_REMEDIATION",
        "REPOSITORY_GENERATION_APPLIED", "REPOSITORY_GENERATION_ADVANCED",
        "RUNTIME_CHECKPOINTED", "RUNTIME_SNAPSHOT_EXPORTED"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "global_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "global_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_sha256"],
      "properties": {
        "event_id": {"oneOf": [{"$ref": "#/$defs/generatedId"}, {"const": "FORMAT2_GENESIS_PREDECESSOR"}]},
        "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "stream": {"enum": ["RUNTIME", "TASK"]},
    "task_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "attempt", "task_sequence", "task_predecessor"],
          "properties": {
            "task_id": {"$ref": "#/$defs/taskId"},
            "attempt": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "task_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
            "task_predecessor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_id", "event_sha256"],
              "properties": {
                "event_id": {"oneOf": [{"$ref": "#/$defs/generatedId"}, {"type": "string", "pattern": "^FORMAT2_TASK_PREDECESSOR:[0-9a-f]{64}$"}]},
                "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      ]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id", "position", "event_count", "operation_key",
        "request_sha256", "response_sha256"
      ],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/generatedId"},
        "position": {"type": "integer", "minimum": 0, "maximum": 10001},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 10002},
        "operation_key": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?:system:v2:(?:genesis|legacy-bridge)|v2:[0-9a-f]{64}:[\\x21-\\x7e]{1,180})$"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "payload_ref": {"$ref": "#/$defs/blobRef"},
    "state_before_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobRef"}]},
    "state_after_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobRef"}]},
    "repository_generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "repository_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_binding_sha256": {"type": "null"},
    "authorizing_use": {"const": "DENY"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "generatedId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "sha256"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"global_sequence": {"const": 0}}, "required": ["global_sequence"]},
      "then": {
        "properties": {
          "stream": {"const": "RUNTIME"},
          "event_type": {"enum": ["RUNTIME_GENESIS", "LEGACY_V1_BRIDGE"]},
          "global_predecessor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "event_sha256"],
            "properties": {
              "event_id": {"const": "FORMAT2_GENESIS_PREDECESSOR"},
              "event_sha256": {"const": "228a5eca65d6da5649229c520a9c922c7de239b821e362beddadacdf278f5a99"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"global_sequence": {"minimum": 1}}, "required": ["global_sequence"]},
      "then": {"properties": {"global_predecessor": {"properties": {"event_id": {"$ref": "#/$defs/generatedId"}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "RUNTIME_GENESIS"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "global_sequence": {"const": 0},
          "transaction": {
            "type": "object",
            "properties": {
              "position": {"const": 0},
              "event_count": {"const": 1},
              "operation_key": {"const": "system:v2:genesis"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"event_type": {"const": "LEGACY_V1_BRIDGE"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "global_sequence": {"const": 0},
          "transaction": {
            "type": "object",
            "properties": {
              "position": {"const": 0},
              "event_count": {"const": 1},
              "operation_key": {"const": "system:v2:legacy-bridge"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stream": {"const": "RUNTIME"}}, "required": ["stream"]},
      "then": {
        "properties": {
          "task_context": {"type": "null"},
          "event_type": {
            "enum": [
              "RUNTIME_GENESIS", "LEGACY_V1_BRIDGE", "COMMAND_COMMITTED",
              "REPOSITORY_GENERATION_ADVANCED", "RUNTIME_CHECKPOINTED",
              "RUNTIME_SNAPSHOT_EXPORTED"
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"stream": {"const": "TASK"}}, "required": ["stream"]},
      "then": {
        "properties": {
          "task_context": {"type": "object"},
          "event_type": {
            "enum": [
              "TASK_INITIALIZED", "CLAIM_ISSUED", "TASK_STARTED",
              "TASK_CONTINUED", "TASK_YIELDED", "TASK_FAILED",
              "TASK_COMPLETED", "CLAIM_RECOVERED", "TASK_RETRIED",
              "GOVERNANCE_BLOCKED", "GOVERNANCE_REVALIDATED",
              "REVIEW_ASSIGNED", "REVIEW_APPROVED", "REVIEW_REJECTED",
              "REVIEW_REMEDIATED", "DIRECTOR_ROUTED", "REMEDIATION_CREATED",
              "TASK_CREATED_FROM_REMEDIATION", "REPOSITORY_GENERATION_APPLIED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_context": {
            "type": "object",
            "properties": {"task_sequence": {"const": 1}},
            "required": ["task_sequence"]
          }
        },
        "required": ["task_context"]
      },
      "then": {
        "properties": {
          "task_context": {
            "type": "object",
            "properties": {
              "task_predecessor": {
                "type": "object",
                "properties": {
                  "event_id": {"pattern": "^FORMAT2_TASK_PREDECESSOR:[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      }
    }
    ,
    {
      "if": {"properties": {"task_context": {"type": "object", "properties": {"task_sequence": {"minimum": 2}}, "required": ["task_sequence"]}}, "required": ["task_context"]},
      "then": {"properties": {"task_context": {"properties": {"task_predecessor": {"properties": {"event_id": {"$ref": "#/$defs/generatedId"}}}}}}}
    }
  ]
}
