{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:approval-attestation:1",
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "actor_alias", "role", "decision", "subject_type", "subject_id", "subject_sha256", "evidence_sha256", "policy_id", "policy_generation", "scope", "issued_at", "valid_until", "disclosures", "attestation_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "attestation_id": {"type": "string", "minLength": 1},
    "actor_alias": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "DENY"]}, "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1}, "subject_sha256": {"$ref": "#/$defs/sha"},
    "evidence_sha256": {"$ref": "#/$defs/sha"}, "policy_id": {"type": "string", "minLength": 1},
    "policy_generation": {"type": "integer", "minimum": 1}, "scope": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"},
    "disclosures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attestation_sha256": {"$ref": "#/$defs/sha"}
  }
}
