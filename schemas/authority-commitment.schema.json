{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:authority-commitment:1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority_id", "generation", "commitment_id",
    "committed_at", "assessment_sha256", "current_state_sha256",
    "experiment_identity_sha256", "claim_identity_sha256", "limitations",
    "commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "commitment_id": {"type": "string", "minLength": 1},
    "committed_at": {"type": "string", "format": "date-time"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "current_state_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_identity_sha256": {"$ref": "#/$defs/sha256"},
    "claim_identity_sha256": {"$ref": "#/$defs/sha256"},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "commitment_sha256": {"$ref": "#/$defs/sha256"}
  }
}
