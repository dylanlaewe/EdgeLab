{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/decision-time-context.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "capture_id", "task_id", "attempt", "observation_boundary", "actual_m0_2_decision_inputs", "contextual_evidence", "supported_fresh_dimensions", "unknown_dimensions", "verification", "limitations", "context_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "context_id": {"const": "H-M0-188-DECISION-TIME-CONTEXT"},
    "capture_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "observation_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "repository_and_runtime_independently_rechecked", "atomic_cross_system_snapshot"],
      "properties": {
        "mode": {"const": "BOUNDED_REPOSITORY_THEN_LOCKED_RUNTIME_READ_RECHECK"},
        "repository_and_runtime_independently_rechecked": {"const": true},
        "atomic_cross_system_snapshot": {"const": false}
      }
    },
    "actual_m0_2_decision_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "task_id", "attempt", "capture_fixture_path", "capture_sidecar_sha256", "historical_seal_sha256", "authority_binding_sha256", "not_retrofitted"],
      "properties": {
        "classification": {"const": "ACTUAL_FROZEN_M0_2_INPUT_CLOSURE"},
        "task_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "capture_fixture_path": {"type": "string", "minLength": 1},
        "capture_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "historical_seal_sha256": {"$ref": "#/$defs/sha256"},
        "authority_binding_sha256": {"$ref": "#/$defs/sha256"},
        "not_retrofitted": {"const": true}
      }
    },
    "contextual_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "source_records", "family_sha256", "source_facts", "subject"],
      "properties": {
        "classification": {"const": "SEPARATELY_OBSERVED_CONTEXT_NOT_DECISION_INPUT"},
        "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "family_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["assignment_handoff", "dependency_capability", "git_repository", "project_stop", "runtime_subject"],
          "properties": {
            "assignment_handoff": {"$ref": "#/$defs/sha256"},
            "dependency_capability": {"$ref": "#/$defs/sha256"},
            "git_repository": {"$ref": "#/$defs/sha256"},
            "project_stop": {"$ref": "#/$defs/sha256"},
            "runtime_subject": {"$ref": "#/$defs/sha256"}
          }
        },
        "source_facts": {"$ref": "#/$defs/sourceFacts"},
        "subject": {"$ref": "#/$defs/subject"}
      }
    },
    "supported_fresh_dimensions": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unknown_dimensions": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification": {"$ref": "#/$defs/verification"},
    "limitations": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "kind", "locator", "source_identity", "content_sha256", "byte_length", "observation_boundary"],
      "properties": {
        "family": {"enum": ["project_stop", "assignment_handoff", "dependency_capability", "git_repository", "runtime_subject"]},
        "kind": {"enum": ["REPOSITORY_FILE", "GIT_VALUE", "SCHEDULER_BUNDLE", "RUNTIME_FILE", "LOCKED_SQLITE_PROJECTION"]},
        "locator": {"type": "string", "minLength": 1},
        "source_identity": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "observation_boundary": {"const": "BOUNDED_REPOSITORY_THEN_LOCKED_RUNTIME_READ_RECHECK"}
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "digest", "project", "stops", "policy", "tasks"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitOid"}, "digest": {"$ref": "#/$defs/sha256"},
        "project": {"$ref": "#/$defs/sha256"}, "stops": {"$ref": "#/$defs/sha256"},
        "policy": {"$ref": "#/$defs/sha256"}, "tasks": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["task_source", "task_attempt", "assignment_source", "handoff_binding_source", "handoff_source", "dependency_ids", "capability_ids", "repository_root", "remote", "head", "bundle"],
      "properties": {
        "task_source": {"type": "string", "minLength": 1}, "task_attempt": {"type": "integer", "minimum": 1},
        "assignment_source": {"type": "string", "minLength": 1}, "handoff_binding_source": {"type": "string", "minLength": 1},
        "handoff_source": {"type": "string", "minLength": 1},
        "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "repository_root": {"type": "string", "minLength": 1}, "remote": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/gitOid"}, "bundle": {"$ref": "#/$defs/bundle"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "attempt", "claim_id", "task_fence", "scheduler_generation", "dispatch_generation", "repository_generation", "runtime_repository_generation", "runtime_id", "attachment_id", "authority_sha256"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1},
        "claim_id": {"type": ["string", "null"], "minLength": 1}, "task_fence": {"type": "integer", "minimum": 0},
        "scheduler_generation": {"type": "integer", "minimum": 0}, "dispatch_generation": {"type": "integer", "minimum": 0},
        "repository_generation": {"type": "integer", "minimum": 0}, "runtime_repository_generation": {"type": "integer", "minimum": 0},
        "runtime_id": {"type": "string", "minLength": 1}, "attachment_id": {"type": "string", "minLength": 1},
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["currentness_status", "verifier_status", "generation_match", "authorizing_use", "authenticated_receipt", "atomic_cross_system_snapshot"],
      "properties": {
        "currentness_status": {"const": "UNKNOWN"}, "verifier_status": {"const": "FAIL"},
        "generation_match": {"const": false}, "authorizing_use": {"const": "DENY"},
        "authenticated_receipt": {"const": false}, "atomic_cross_system_snapshot": {"const": false}
      }
    }
  }
}
