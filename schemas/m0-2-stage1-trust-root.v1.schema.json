{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgelab.local/schemas/m0-2-stage1-trust-root.v1.schema.json",
  "title": "EdgeLab M0.2 stage-one trust root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_id", "freeze_commit", "entrypoint", "modules", "schemas", "dependency_closure", "host_boundary", "root_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "root_id": {"const": "M0-2-STAGE1-TRUST-ROOT-V1"},
    "freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entrypoint": {"const": "edgelab.orchestration.decision"},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "schemas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "dependency_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "closure_id", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/[A-Za-z0-9._/-]+$"},
        "closure_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["python_implementation", "python_major_minor", "platform", "architecture", "git_model", "environment_allowlist"],
      "properties": {
        "python_implementation": {"type": "string", "minLength": 1},
        "python_major_minor": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "git_model": {"type": "string", "minLength": 1},
        "environment_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "root_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(src/edgelab|schemas)/[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
