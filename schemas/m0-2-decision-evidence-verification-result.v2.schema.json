{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["historical_status","currentness_status","target_runtime_compatible","verifier_status","exact_generation_match","authorizing_use","reason_code"],"properties":{"historical_status":{"enum":["VALID","INVALID"]},"currentness_status":{"enum":["CURRENT","STALE","INCOMPATIBLE","UNKNOWN"]},"target_runtime_compatible":{"type":"boolean"},"verifier_status":{"enum":["PASS","FAIL"]},"exact_generation_match":{"type":"boolean"},"authorizing_use":{"enum":["ALLOW","DENY"]},"reason_code":{"enum":["NONE","SCHEMA_INVALID","CONTENT_INVALID","SEMANTIC_INVALID","STALE_AUTHORITY","WRONG_RUNTIME","GENERATION_MISMATCH","CURRENTNESS_UNKNOWN"]},"explanation":{"type":"string","maxLength":1024}},"allOf":[{"if":{"properties":{"authorizing_use":{"const":"ALLOW"}}},"then":{"properties":{"historical_status":{"const":"VALID"},"currentness_status":{"const":"CURRENT"},"target_runtime_compatible":{"const":true},"verifier_status":{"const":"PASS"},"exact_generation_match":{"const":true},"reason_code":{"const":"NONE"}}}},{"if":{"properties":{"historical_status":{"const":"INVALID"}}},"then":{"properties":{"authorizing_use":{"const":"DENY"}}}},{"if":{"properties":{"target_runtime_compatible":{"const":false}}},"then":{"properties":{"authorizing_use":{"const":"DENY"}}}}]}
