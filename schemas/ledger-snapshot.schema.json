{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:edgelab:ledger-snapshot:2", "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["stake", "action_id", "action_sha256", "position_id", "strategy_id", "strategy_version", "experiment_identity_sha256", "strategy_identity_sha256", "event_identity_sha256", "market_identity_sha256", "selection_identity_sha256", "liability_identity_sha256", "economic_identity_sha256"],
      "properties": {"stake": {"type": "integer", "minimum": 1}, "action_id": {"type": "string", "minLength": 1}, "action_sha256": {"$ref": "#/$defs/sha"}, "position_id": {"type": "string", "minLength": 1}, "strategy_id": {"type": "string", "minLength": 1}, "strategy_version": {"type": "integer", "minimum": 1}, "experiment_identity_sha256": {"$ref": "#/$defs/sha"}, "strategy_identity_sha256": {"$ref": "#/$defs/sha"}, "event_identity_sha256": {"$ref": "#/$defs/sha"}, "market_identity_sha256": {"$ref": "#/$defs/sha"}, "selection_identity_sha256": {"$ref": "#/$defs/sha"}, "liability_identity_sha256": {"$ref": "#/$defs/sha"}, "economic_identity_sha256": {"$ref": "#/$defs/sha"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "account", "currency", "opening_minor", "cash_minor", "reserved_minor", "liability_minor", "realized_minor", "sequence", "last_event_sha256", "open_reservations", "open_reservation_bindings", "as_of", "valid_until", "snapshot_sha256"],
  "properties": {"schema_version": {"const": 1}, "account": {"enum": ["PAPER", "LIVE"]}, "currency": {"const": "USD"}, "opening_minor": {"type": "integer", "minimum": 0}, "cash_minor": {"type": "integer", "minimum": 0}, "reserved_minor": {"type": "integer", "minimum": 0}, "liability_minor": {"type": "integer", "minimum": 0}, "realized_minor": {"type": "integer"}, "sequence": {"type": "integer", "minimum": 1}, "last_event_sha256": {"$ref": "#/$defs/sha"}, "open_reservations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "open_reservation_bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/binding"}}, "as_of": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}, "snapshot_sha256": {"$ref": "#/$defs/sha"}}
}
