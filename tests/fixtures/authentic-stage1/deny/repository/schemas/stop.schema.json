{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:stop:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "issued_at",
    "issuer",
    "reason",
    "affected_components",
    "evidence_refs",
    "severity",
    "remediation_required",
    "status",
    "resolution_event_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM"
      ]
    },
    "remediation_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED"
      ]
    },
    "resolution_event_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
