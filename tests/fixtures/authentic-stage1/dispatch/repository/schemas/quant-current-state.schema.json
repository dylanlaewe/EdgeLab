{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:quant-current-state:1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "inventory"],
      "properties": {
        "baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "inventory": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority_id", "generation", "accepted_at",
    "predecessor_state_sha256", "pre_access_checkpoint",
    "pre_access_checkpoint_sha256", "current_checkpoint", "state_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "accepted_at": {"type": "string", "format": "date-time"},
    "predecessor_state_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "pre_access_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "pre_access_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "current_checkpoint": {"$ref": "#/$defs/checkpoint"},
    "state_sha256": {"$ref": "#/$defs/sha256"}
  }
}
