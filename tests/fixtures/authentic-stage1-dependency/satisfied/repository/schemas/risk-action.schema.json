{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:edgelab:risk-action:1", "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "action_id", "created_at", "expires_at", "action_type", "environment", "strategy_id", "strategy_version", "experiment_identity_sha256", "strategy_identity_sha256", "source_identity_sha256", "event_identity_sha256", "market_identity_sha256", "selection_identity_sha256", "position_id", "amount_minor", "price_constraint_sha256", "reservation_id", "related_action_sha256", "action_sha256"],
  "properties": {"schema_version": {"const": 1}, "action_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "action_type": {"enum": ["NEW_EXPOSURE", "SETTLEMENT"]}, "environment": {"enum": ["PAPER", "LIVE"]}, "strategy_id": {"type": "string", "minLength": 1}, "strategy_version": {"type": "integer", "minimum": 1}, "experiment_identity_sha256": {"$ref": "#/$defs/sha"}, "strategy_identity_sha256": {"$ref": "#/$defs/sha"}, "source_identity_sha256": {"$ref": "#/$defs/sha"}, "event_identity_sha256": {"$ref": "#/$defs/sha"}, "market_identity_sha256": {"$ref": "#/$defs/sha"}, "selection_identity_sha256": {"$ref": "#/$defs/sha"}, "position_id": {"type": "string", "minLength": 1}, "amount_minor": {"type": "integer", "minimum": 1}, "price_constraint_sha256": {"$ref": "#/$defs/sha"}, "reservation_id": {"type": ["string", "null"], "minLength": 1}, "related_action_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "action_sha256": {"$ref": "#/$defs/sha"}},
  "allOf": [
    {"if": {"properties": {"action_type": {"const": "NEW_EXPOSURE"}}}, "then": {"properties": {"reservation_id": {"type": "null"}, "related_action_sha256": {"type": "null"}}}},
    {"if": {"properties": {"action_type": {"const": "SETTLEMENT"}}}, "then": {"properties": {"reservation_id": {"type": "string", "minLength": 1}, "related_action_sha256": {"$ref": "#/$defs/sha"}}}}
  ]
}
