{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgelab:trial-inventory:1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "id", "version", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "version", "created_at", "supersedes", "kind", "observed_through", "trials", "trial_registry_sha256", "status_counts"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "version": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"},
    "supersedes": {"anyOf": [{"$ref": "#/$defs/typed_ref"}, {"type": "null"}]}, "kind": {"const": "trial-inventory"},
    "observed_through": {"type": "string", "format": "date-time"},
    "trials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/typed_ref"}},
    "trial_registry_sha256": {"$ref": "#/$defs/sha256"},
    "status_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["ATTEMPTED", "SUCCEEDED", "FAILED", "CANCELLED"],
      "properties": {"ATTEMPTED": {"type": "integer", "minimum": 0}, "SUCCEEDED": {"type": "integer", "minimum": 0}, "FAILED": {"type": "integer", "minimum": 0}, "CANCELLED": {"type": "integer", "minimum": 0}}
    }
  }
}
