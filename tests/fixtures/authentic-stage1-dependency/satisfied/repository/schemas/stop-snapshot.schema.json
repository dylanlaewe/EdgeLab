{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:edgelab:stop-snapshot:1",
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "targets"], "properties": {"kind": {"enum": ["global", "records"]}, "targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generation", "generated_at", "valid_until", "trusted", "complete", "stops"],
  "properties": {
    "schema_version": {"const": 1}, "generation": {"type": "integer", "minimum": 1}, "generated_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"},
    "trusted": {"type": "boolean"}, "complete": {"type": "boolean"},
    "stops": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stop_ref", "stop_sha256", "actions", "scope"], "properties": {"stop_ref": {"type": "string", "minLength": 1}, "stop_sha256": {"$ref": "#/$defs/sha"}, "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "scope": {"$ref": "#/$defs/scope"}}}}
  }
}
